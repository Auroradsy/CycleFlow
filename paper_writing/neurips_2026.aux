\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Unified ablation. All variants on shared axes: bottleneck dim, reconstruction regime (mean vs.\ sum-dominant), self-recon SSIM (a collapse indicator: $0.68$=mean-brain), cross-modal SSIM, alignment CCA (chance $0.25$), and GMM cluster quality (silhouette Sil, Davies--Bouldin DB). All recon numbers are SSIM (PSNR in Table~\ref {tab:gen}). Alignment appears \emph  {only} with sum-recon \emph  {and} low dim; removing cross-recon breaks it; GMM strength moves Sil/DB, not synthesis.}}{3}{table.3}\protected@file@percent }
\newlabel{tab:abl}{{3}{3}{Unified ablation. All variants on shared axes: bottleneck dim, reconstruction regime (mean vs.\ sum-dominant), self-recon SSIM (a collapse indicator: $0.68$=mean-brain), cross-modal SSIM, alignment CCA (chance $0.25$), and GMM cluster quality (silhouette Sil, Davies--Bouldin DB). All recon numbers are SSIM (PSNR in Table~\ref {tab:gen}). Alignment appears \emph {only} with sum-recon \emph {and} low dim; removing cross-recon breaks it; GMM strength moves Sil/DB, not synthesis}{table.3}{}}
